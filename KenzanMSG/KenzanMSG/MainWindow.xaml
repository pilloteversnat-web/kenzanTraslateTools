<Window x:Class="KenzanMSG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yakuza MSG Batch Translator (.NET 10)" Height="480" Width="750"
        WindowStartupLocation="CenterScreen" Background="#FFF3F3F3">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Selección de Carpeta (Diseño responsivo con Grid en lugar de StackPanel estático) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtFolderPath" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="5,0" 
                     IsReadOnly="True" ToolTip="Carpeta seleccionada para procesamiento"/>
            <Button x:Name="btnSelectFolder" Grid.Column="2" Content="Explorar..." Height="32" 
                    Click="BtnSelectFolder_Click" Cursor="Hand"/>
        </Grid>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="btnExport" Content="📤 Exportar MSG a TXT" Width="180" Height="38" Margin="0,0,12,0" 
                    Background="#FF007ACC" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="BtnExport_Click"/>
            <Button x:Name="btnImport" Content="📥 Importar TXT a MSG" Width="180" Height="38" 
                    Background="#FF28A745" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="BtnImport_Click"/>
        </StackPanel>

        <!-- Consola de Estado / Log (Con borde redondeado y contenedor moderno) -->
        <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="3" Background="#FF1E1E1E">
            <TextBox x:Name="txtLog" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" 
                     Background="Transparent" Foreground="#FF00FF00" FontFamily="Consolas" FontSize="12" Padding="8"
                     BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Barra de Estado inferior -->
        <StatusBar Grid.Row="3" Margin="0,10,0,0" Background="#FFE6E6E6">
            <StatusBarItem x:Name="lblStatus" Content="Listo."/>
        </StatusBar>
        
    </Grid>
</Window>
